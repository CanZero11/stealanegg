local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local root = character:WaitForChild("HumanoidRootPart")

-- ============================================================
-- 📌 VARIABEL GLOBAL
-- ============================================================
local eggFolder = "Eggs" -- Ganti sesuai folder egg di game
local treadmillPart = "Treadmill" -- Ganti sesuai nama part treadmill
local monsterFolder = "Monsters" -- Ganti sesuai folder monster

local isAutoSteal = false
local isAutoTreadmill = false
local isAutoFeed = false
local isHubOpen = false

local eggPriority = {
    ["Cosmic"] = 100,
    ["Eternal"] = 90,
    ["Legendary"] = 70,
    ["Epic"] = 50,
    ["Rare"] = 30,
    ["Common"] = 10
}

-- ============================================================
-- 📌 FUNGSI UTILITY
-- ============================================================
function getClosestEgg()
    local eggs = workspace:FindFirstChild(eggFolder)
    if not eggs then return nil end
    local closest = nil
    local closestDist = math.huge
    for _, egg in ipairs(eggs:GetChildren()) do
        if egg:IsA("Part") or egg:IsA("Model") then
            local pos = egg.Position
            local dist = (root.Position - pos).Magnitude
            local priority = eggPriority[egg.Name] or 10
            if dist < closestDist and priority > 0 then
                closest = egg
                closestDist = dist
            end
        end
    end
    return closest
end

function getTreadmill()
    return workspace:FindFirstChild(treadmillPart)
end

function getMonsters()
    return workspace:FindFirstChild(monsterFolder)
end

function teleportTo(target)
    if target then
        root.CFrame = CFrame.new(target.Position + Vector3.new(0, 3, 0))
        wait(0.5)
    end
end

function notify(title, text, duration)
    game.StarterGui:SetCore("SendNotification", {
        Title = title,
        Text = text,
        Duration = duration or 3
    })
end

-- ============================================================
-- 📌 AUTO STEAL EGG (PRIORITAS COSMIC & ETERNAL)
-- ============================================================
function autoStealEgg()
    while isAutoSteal do
        local egg = getClosestEgg()
        if egg then
            teleportTo(egg)
            wait(0.3)
            -- Simulasi steal (klik / action)
            local action = egg:FindFirstChild("ClickDetector") or egg:FindFirstChild("ProximityPrompt")
            if action then
                if action:IsA("ClickDetector") then
                    fireclickdetector(action)
                elseif action:IsA("ProximityPrompt") then
                    action:InputHold()
                    wait(0.5)
                    action:InputRelease()
                end
            end
            notify("🥚 STEAL EGG", "Mencuri: " .. egg.Name, 2)
        end
        wait(1)
    end
end

-- ============================================================
-- 📌 AUTO TREADMILL (NAIKIN SPEED)
-- ============================================================
function autoTreadmill()
    while isAutoTreadmill do
        local tm = getTreadmill()
        if tm then
            teleportTo(tm)
            wait(0.5)
            -- Simulasi naik treadmill
            humanoid.WalkSpeed = humanoid.WalkSpeed + 0.5
            if humanoid.WalkSpeed > 50 then
                humanoid.WalkSpeed = 16 -- reset
            end
            notify("🏃 AUTO TREADMILL", "Speed: " .. math.floor(humanoid.WalkSpeed), 1)
        end
        wait(3)
    end
end

-- ============================================================
-- 📌 AUTO FEED MONSTER
-- ============================================================
function autoFeedMonster()
    while isAutoFeed do
        local monsters = getMonsters()
        if monsters then
            for _, monster in ipairs(monsters:GetChildren()) do
                if monster:IsA("Model") or monster:IsA("Part") then
                    teleportTo(monster)
                    wait(0.5)
                    -- Simulasi feed (klik / action)
                    local action = monster:FindFirstChild("ClickDetector") or monster:FindFirstChild("ProximityPrompt")
                    if action then
                        if action:IsA("ClickDetector") then
                            fireclickdetector(action)
                        elseif action:IsA("ProximityPrompt") then
                            action:InputHold()
                            wait(0.5)
                            action:InputRelease()
                        end
                    end
                    notify("🍖 FEED MONSTER", "Memberi makan: " .. monster.Name, 2)
                end
            end
        end
        wait(2)
    end
end

